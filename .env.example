# ==============================================================================
# MINDBRIDGE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey)
# All of the following variable names are supported automatically:
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional alternative provider: https://openrouter.ai/keys)
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Configuration (Optional: for persistent cloud database & authentication)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
